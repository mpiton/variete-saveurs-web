# Cloudflare Pages *concatène* les valeurs d'un même en-tête quand plusieurs règles
# correspondent — il ne les écrase pas. Un `Cache-Control` sur `/*` gagnerait donc
# toujours sur celui de `/_astro/*` (première valeur lue par le navigateur).
# D'où le découpage : en-têtes de sécurité partout, cache par forme d'URL.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # La politique vit désormais dans astro.config.mjs (`security.csp`) : Astro empreinte
  # ses scripts et ses styles au build, ce qui remplace le 'unsafe-inline' d'avant.
  # Elle sort en <meta http-equiv> ; frame-ancestors y étant ignoré, il reste ici.
  # Deux politiques s'appliquent par intersection, donc rien d'autre ne doit y figurer :
  # une directive répétée ici ne pourrait que restreindre celle du meta, jamais l'élargir.
  Content-Security-Policy: frame-ancestors 'none'

# Noms de fichiers hachés par Astro : le contenu ne change jamais sous une même URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Les pages HTML : `build.format` reste en `directory`, donc toute page se termine
# par `/`. Le HTML change à chaque déploiement, qui purge le cache Cloudflare.
/
  Cache-Control: public, max-age=600, must-revalidate
/*/
  Cache-Control: public, max-age=600, must-revalidate

/api/*
  Cache-Control: no-store
